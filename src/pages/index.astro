---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../utils/date';

// Fetch data
const games = await getCollection('games');
const blogPosts = await getCollection('blog');
const devlogs = await getCollection('devlogs');
const projects = await getCollection('projects');

// Sort games by date descending
const sortedGames = games.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
const featuredGame = sortedGames[0];

// Get updates: combine blog posts and devlog entries

interface UpdateItem {
  type: 'blog' | 'devlog';
  title: string;
  title_en: string;
  date: Date;
  summary: string;
  summary_en: string;
  url: string;
  category_es: string;
  category_en: string;
}

const updates: UpdateItem[] = [
  ...blogPosts.map(post => ({
    type: 'blog' as const,
    title: post.data.title,
    title_en: post.data.title_en || post.data.title,
    date: post.data.pubDate,
    summary: post.data.description,
    summary_en: post.data.description_en || post.data.description,
    url: `/blog/${post.id}`,
    category_es: 'Post del Blog',
    category_en: 'Blog Post'
  })),
  ...devlogs.map(log => {
    const proj = projects.find(p => p.id === log.data.project);
    return {
      type: 'devlog' as const,
      title: log.data.title,
      title_en: log.data.title_en || log.data.title,
      date: log.data.date,
      summary: log.data.summary,
      summary_en: log.data.summary_en || log.data.summary,
      url: `/proyectos/${log.data.project}`,
      category_es: `Devlog - ${proj ? proj.data.title : 'Proyecto'}`,
      category_en: `Devlog - ${proj ? (proj.data.title_en || proj.data.title) : 'Project'}`
    };
  })
];

// Sort updates by date descending and take top 3
const recentUpdates = updates
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 3);
---

<Layout>
  <!-- Hero Section -->
  <section class="hero-section pixel-box scanlines">
    <div class="hero-content">
      <img src="/images/logo.png" alt="Cactus Byte Studio Logo" class="hero-logo" />
      <div class="hero-text-block">
        <h1 class="hero-title">Cactus Byte Studio</h1>
        
        <p class="hero-subtitle lang-es">Videojuegos Indie, Música, Arte, Narrativa y Tecnología</p>
        <p class="hero-subtitle lang-en">Indie Game Dev, Music, Art, Storytelling & Tech</p>
        
        <p class="hero-desc lang-es">
          Un espacio para desarrollar ideas narrativas e imaginativas que dejen huella.
        </p>
        <p class="hero-desc lang-en">
          A space for crafting imaginative, narrative-driven ideas that leave a lasting impression.
        </p>
        
        <div class="hero-buttons">
          <a href="/juegos" class="btn">
            <span class="lang-es">Explorar Juegos</span>
            <span class="lang-en">Explore Games</span>
          </a>
          <a href="/acerca-de" class="btn btn-secondary">
            <span class="lang-es">Conoceme</span>
            <span class="lang-en">About Me</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Split Grid: Featured & Recent Updates -->
  <div class="split-layout">
    <!-- Featured Game Column -->
    <section class="featured-column">
      <h2 class="section-title">
        <span class="lang-es">Último Lanzamiento</span>
        <span class="lang-en">Latest Release</span>
      </h2>
      {featuredGame ? (
        <div class="pixel-box featured-game-box">
          <div class="featured-image-wrapper">
            <img src={featuredGame.data.coverImage} alt={featuredGame.data.title} class="featured-game-image" />
          </div>
          <div class="featured-game-details">
            <span class="badge success">
              <span class="lang-es">{featuredGame.data.status}</span>
              <span class="lang-en">{featuredGame.data.status === 'Publicado' ? 'Published' : featuredGame.data.status === 'En Desarrollo' ? 'In Development' : featuredGame.data.status}</span>
            </span>
            <h3 class="featured-title">
              <span class="lang-es">{featuredGame.data.title}</span>
              <span class="lang-en">{featuredGame.data.title_en || featuredGame.data.title}</span>
            </h3>
            <p class="featured-description">
              <span class="lang-es">{featuredGame.data.description}</span>
              <span class="lang-en">{featuredGame.data.description_en || featuredGame.data.description}</span>
            </p>
            <div class="featured-platforms">
              <strong>
                <span class="lang-es">Plataformas:</span>
                <span class="lang-en">Platforms:</span>
              </strong> {featuredGame.data.platforms.join(', ')}
            </div>
            <a href={`/juegos/${featuredGame.id}`} class="btn btn-primary">
              <span class="lang-es">Ver Detalles del Juego</span>
              <span class="lang-en">View Game Details</span>
            </a>
          </div>
        </div>
      ) : (
        <div class="pixel-box">
          <p class="lang-es">No hay juegos publicados por el momento.</p>
          <p class="lang-en">No games published at the moment.</p>
        </div>
      )}
    </section>

    <!-- Recent Updates Column -->
    <section class="updates-column">
      <h2 class="section-title">
        <span class="lang-es">Novedades y Avances</span>
        <span class="lang-en">News & Updates</span>
      </h2>
      <div class="updates-list">
        {recentUpdates.length > 0 ? (
          recentUpdates.map(update => (
            <a href={update.url} class="pixel-box interactive update-card">
              <div class="update-meta">
                <span class="badge warning">
                  <span class="lang-es">{update.category_es}</span>
                  <span class="lang-en">{update.category_en}</span>
                </span>
                <span class="update-date">{formatDate(update.date)}</span>
              </div>
              <h3 class="update-title">
                <span class="lang-es">{update.title}</span>
                <span class="lang-en">{update.title_en}</span>
              </h3>
              <p class="update-summary">
                <span class="lang-es">{update.summary}</span>
                <span class="lang-en">{update.summary_en}</span>
              </p>
            </a>
          ))
        ) : (
          <div class="pixel-box">
            <p class="lang-es">No hay actualizaciones recientes por el momento.</p>
            <p class="lang-en">No recent updates at the moment.</p>
          </div>
        )}
      </div>
    </section>
  </div>
</Layout>

<style>
  /* Hero Section */
  .hero-section {
    padding: 3rem 2rem;
    background-color: var(--color-panel);
    margin-bottom: 4rem;
  }

  .hero-content {
    display: flex;
    align-items: center;
    gap: 3rem;
    flex-wrap: wrap;
  }

  .hero-logo {
    width: 160px;
    height: 160px;
    image-rendering: pixelated;
    filter: drop-shadow(4px 4px 0px rgba(0,0,0,0.5));
    animation: float 4s ease-in-out infinite;
  }

  .hero-text-block {
    flex: 1;
    min-width: 280px;
  }

  .hero-title {
    font-size: 2.2rem;
    color: var(--color-accent-yellow);
    margin-bottom: 0.5rem;
    text-shadow: 2px 2px 0px rgba(0,0,0,0.5);
  }

  .hero-subtitle {
    font-family: var(--font-pixel);
    font-size: 0.9rem;
    color: var(--color-accent-green);
    margin-bottom: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hero-desc {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
    max-width: 600px;
  }

  .hero-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @keyframes float {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  /* Split Layout */
  .split-layout {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 3rem;
  }

  @media (max-width: 900px) {
    .split-layout {
      grid-template-columns: 1fr;
    }
  }

  /* Featured Game */
  .featured-game-box {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 1.5rem;
  }

  .featured-image-wrapper {
    width: 100%;
    height: 250px;
    overflow: hidden;
    border: var(--border-width) solid var(--color-border);
    background-color: var(--color-bg);
  }

  .featured-game-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    image-rendering: pixelated;
  }

  .featured-game-details {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .featured-title {
    font-size: 1.3rem;
    color: var(--color-accent-yellow);
  }

  .featured-description {
    color: var(--color-text);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .featured-platforms {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  /* Updates */
  .updates-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .update-card {
    display: block;
    color: inherit;
    padding: 1.25rem;
  }

  .update-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
    font-size: 0.8rem;
  }

  .update-date {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }

  .update-title {
    font-size: 0.95rem;
    color: var(--color-accent-yellow);
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .update-card:hover .update-title {
    color: var(--color-accent-green);
  }

  .update-summary {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 600px) {
    .hero-content {
      flex-direction: column;
      text-align: center;
      gap: 1.5rem;
    }

    .hero-logo {
      width: 120px;
      height: 120px;
    }

    .hero-buttons {
      justify-content: center;
    }
  }
</style>
