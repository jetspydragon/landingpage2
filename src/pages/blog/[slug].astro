---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { formatDate } from '../../utils/date';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout 
  title={`${post.data.title} — Cactus Byte Studio`} 
  title_en={`${post.data.title_en || post.data.title} — Cactus Byte Studio`}
  description={post.data.description}
  description_en={post.data.description_en}
>
  <div class="post-navigation">
    <a href="/blog" class="back-link">
      <span class="arrow">←</span>
      <span class="lang-es">Volver a la bitácora</span>
      <span class="lang-en">Back to logbook</span>
    </a>
  </div>

  <article class="pixel-box post-article">
    <header class="post-header">
      <div class="post-meta">
        <span class="badge warning">{formatDate(post.data.pubDate)}</span>
        <div class="post-tags">
          {post.data.tags.map((tag: string) => (
            <span class="badge">{tag}</span>
          ))}
        </div>
      </div>
      
      <h1 class="post-title">
        <span class="lang-es">{post.data.title}</span>
        <span class="lang-en">{post.data.title_en || post.data.title}</span>
      </h1>
      <p class="post-summary">
        <span class="lang-es">{post.data.description}</span>
        <span class="lang-en">{post.data.description_en || post.data.description}</span>
      </p>
    </header>

    {post.data.heroImage && (
      <div class="post-hero-image-wrapper">
        <img src={post.data.heroImage} alt={post.data.title} class="post-hero-image" />
      </div>
    )}

    <div class="post-content content-multilang">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .post-navigation {
    margin-bottom: 2rem;
  }

  .back-link {
    font-family: var(--font-pixel);
    font-size: 0.85rem;
    color: var(--color-accent-green);
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .back-link:hover {
    color: var(--color-accent-yellow);
  }

  .post-article {
    padding: 3rem;
    background-color: var(--color-panel);
  }

  .post-header {
    margin-bottom: 2rem;
    border-bottom: 2px dashed var(--color-border);
    padding-bottom: 2rem;
  }

  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .post-tags {
    display: flex;
    gap: 0.4rem;
  }

  .post-title {
    font-size: 1.8rem;
    color: var(--color-accent-yellow);
    margin-bottom: 1rem;
    line-height: 1.3;
  }

  .post-summary {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .post-hero-image-wrapper {
    width: 100%;
    max-height: 400px;
    overflow: hidden;
    border: var(--border-width) solid var(--color-border);
    margin-bottom: 3rem;
    background-color: var(--color-bg);
  }

  .post-hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    image-rendering: pixelated;
  }

  /* Style markdown content inside post-content */
  .post-content {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-text);
  }

  .post-content :global(p) {
    margin-bottom: 1.5rem;
  }

  .post-content :global(h2), 
  .post-content :global(h3) {
    color: var(--color-accent-yellow);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .post-content :global(h2) {
    font-size: 1.25rem;
    border-bottom: 1px dashed var(--color-border);
    padding-bottom: 0.5rem;
  }

  .post-content :global(h3) {
    font-size: 1.05rem;
  }

  .post-content :global(ul), 
  .post-content :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .post-content :global(strong) {
    color: var(--color-accent-yellow);
  }

  .post-content :global(code) {
    font-family: var(--font-mono);
    background-color: var(--color-bg);
    color: var(--color-accent-green);
    padding: 0.2rem 0.4rem;
    border: 1px solid var(--color-border);
    font-size: 0.9em;
  }

  .post-content :global(pre) {
    background-color: var(--color-bg) !important;
    border: var(--border-width) solid var(--color-border);
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    overflow-x: auto;
    font-family: var(--font-mono);
  }

  .post-content :global(pre code) {
    background-color: transparent;
    border: none;
    padding: 0;
    color: inherit;
  }

  .post-content :global(blockquote) {
    border-left: var(--border-width) solid var(--color-accent-green);
    background-color: rgba(140, 168, 141, 0.05);
    padding: 1rem 1.5rem;
    margin-bottom: 1.5rem;
    font-style: italic;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .post-article {
      padding: 1.5rem;
    }
    
    .post-title {
      font-size: 1.4rem;
    }
  }
</style>
