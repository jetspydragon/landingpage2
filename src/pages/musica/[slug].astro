---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { formatDate } from '../../utils/date';

export async function getStaticPaths() {
  const tracks = await getCollection('music');
  return tracks.map(track => ({
    params: { slug: track.id },
    props: { track },
  }));
}

const { track } = Astro.props;
const { Content } = await render(track);
---

<Layout 
  title={`${track.data.title} — Música — Cactus Byte Studio`} 
  title_en={`${track.data.title_en || track.data.title} — Music — Cactus Byte Studio`} 
  description={track.data.description}
  description_en={track.data.description_en}
>
  <div class="music-navigation">
    <a href="/musica" class="back-link">
      <span class="arrow">←</span>
      <span class="lang-es">Volver a Música</span>
      <span class="lang-en">Back to Music</span>
    </a>
  </div>

  <article class="pixel-box music-detail-box">
    <header class="music-header">
      <div class="music-meta">
        <span class="badge warning">
          <span class="lang-es">Lanzamiento: {formatDate(track.data.releaseDate)}</span>
          <span class="lang-en">Release: {formatDate(track.data.releaseDate)}</span>
        </span>
      </div>
      <h1 class="music-title">
        <span class="lang-es">{track.data.title}</span>
        <span class="lang-en">{track.data.title_en || track.data.title}</span>
      </h1>
    </header>

    <div class="music-grid-layout">
      {track.data.coverImage && (
        <div class="music-cover-wrapper">
          <img src={track.data.coverImage} alt={track.data.title} class="music-cover" />
        </div>
      )}

      <div class="music-info-panel pixel-box">
        <h3>
          <span class="lang-es">Ficha Técnica</span>
          <span class="lang-en">Tech Sheet</span>
        </h3>
        <ul class="info-list">
          <li>
            <strong>
              <span class="lang-es">Publicación:</span>
              <span class="lang-en">Published:</span>
            </strong> {formatDate(track.data.releaseDate)}
          </li>
        </ul>
        <div class="action-buttons">
          <a href={track.data.linkUrl} target="_blank" rel="noopener noreferrer" class="btn btn-bandcamp">
            <span class="lang-es">Escuchar en Bandcamp</span>
            <span class="lang-en">Listen on Bandcamp</span>
          </a>
        </div>
      </div>
    </div>

    {track.data.embedUrl && (
      <div class="music-player-wrapper">
        <iframe 
          style="border: 0; width: 100%; height: 120px;" 
          src={track.data.embedUrl} 
          loading="lazy"
          title={`Reproductor para ${track.data.title}`}
        >
        </iframe>
      </div>
    )}

    <div class="music-content content-multilang">
      <Content />
    </div>

    {track.data.gallery && track.data.gallery.length > 0 && (
      <div class="music-gallery-section">
        <h3 class="gallery-title">
          <span class="lang-es">Galería de Imágenes</span>
          <span class="lang-en">Image Gallery</span>
        </h3>
        <div class="gallery-grid">
          {track.data.gallery.map((img, index) => (
            <div class="gallery-item pixel-box">
              <img src={img} alt={`Imagen ${index + 1} de ${track.data.title}`} class="gallery-img" />
            </div>
          ))}
        </div>
      </div>
    )}
  </article>
</Layout>

<style>
  .music-navigation {
    margin-bottom: 2rem;
  }

  .back-link {
    font-family: var(--font-pixel);
    font-size: 0.85rem;
    color: var(--color-accent-green);
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .back-link:hover {
    color: var(--color-accent-yellow);
  }

  .music-detail-box {
    padding: 3rem;
    background-color: var(--color-panel);
  }

  .music-header {
    margin-bottom: 2rem;
    border-bottom: 2px dashed var(--color-border);
    padding-bottom: 2rem;
  }

  .music-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .music-title {
    font-size: 1.8rem;
    color: var(--color-accent-yellow);
    line-height: 1.3;
  }

  .music-grid-layout {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 2.5rem;
    margin-bottom: 3rem;
    align-items: start;
  }

  @media (max-width: 768px) {
    .music-grid-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .music-detail-box {
      padding: 1.5rem;
    }
    .music-title {
      font-size: 1.4rem;
    }
  }

  .music-cover-wrapper {
    width: 100%;
    max-height: 350px;
    overflow: hidden;
    border: var(--border-width) solid var(--color-border);
    background-color: var(--color-bg);
  }

  .music-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    image-rendering: pixelated;
  }

  .music-info-panel {
    background-color: var(--color-bg);
    padding: 1.5rem;
    box-shadow: none;
  }

  .music-info-panel h3 {
    font-size: 1rem;
    color: var(--color-accent-yellow);
    margin-bottom: 1rem;
    border-bottom: 1px dashed var(--color-border);
    padding-bottom: 0.5rem;
  }

  .info-list {
    list-style: none;
    margin-bottom: 1.5rem;
  }

  .info-list li {
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
    color: var(--color-text-muted);
  }

  .info-list li strong {
    color: var(--color-text);
  }

  .btn-bandcamp {
    width: 100%;
    background-color: var(--color-accent-green);
    color: var(--color-text-dark);
    border-color: var(--color-accent-green);
  }

  .btn-bandcamp:hover {
    background-color: var(--color-accent-yellow);
    color: var(--color-text-dark);
    border-color: var(--color-accent-yellow);
  }

  .music-player-wrapper {
    width: 100%;
    border: var(--border-width) solid var(--color-border);
    background-color: var(--color-bg);
    overflow: hidden;
    margin-bottom: 2.5rem;
  }

  .music-content {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-text);
  }

  .music-content :global(p) {
    margin-bottom: 1.5rem;
  }

  .music-content :global(h2),
  .music-content :global(h3) {
    color: var(--color-accent-yellow);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .music-content :global(h2) {
    font-size: 1.25rem;
    border-bottom: 1px dashed var(--color-border);
    padding-bottom: 0.5rem;
  }

  .music-content :global(h3) {
    font-size: 1.1rem;
  }

  .music-content :global(ol),
  .music-content :global(ul) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .music-content :global(li) {
    margin-bottom: 0.5rem;
    color: var(--color-text-muted);
  }
  
  .music-content :global(strong) {
    color: var(--color-accent-yellow);
  }

  .music-content :global(img) {
    max-width: 100%;
    height: auto;
    border: var(--border-width) solid var(--color-border);
    box-shadow: var(--pixel-shadow);
    margin: 1.5rem 0;
    display: block;
    image-rendering: pixelated;
  }

  .music-gallery-section {
    margin-top: 3rem;
    border-top: 2px dashed var(--color-border);
    padding-top: 2rem;
  }

  .gallery-title {
    font-size: 1.1rem;
    color: var(--color-accent-yellow);
    margin-bottom: 1.5rem;
    font-family: var(--font-pixel);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
  }

  .gallery-item {
    padding: 0;
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }

  .gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    image-rendering: pixelated;
    transition: transform 0.2s ease;
  }

  .gallery-item:hover .gallery-img {
    transform: scale(1.05);
  }
</style>
