---
import Layout from '../../layouts/Layout.astro';
import DevlogTimeline from '../../components/DevlogTimeline.astro';
import { getCollection, render } from 'astro:content';
import { formatDate } from '../../utils/date';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

// Fetch all devlogs and filter by this project slug
const allDevlogs = await getCollection('devlogs');
const projectDevlogs = allDevlogs.filter(log => log.data.project === project.id);
---

<Layout 
  title={`${project.data.title} — Cactus Byte Studio`} 
  title_en={`${project.data.title_en || project.data.title} — Projects — Cactus Byte Studio`}
  description={project.data.description}
  description_en={project.data.description_en}
>
  <div class="project-navigation">
    <a href="/proyectos" class="back-link">
      <span class="arrow">←</span>
      <span class="lang-es">Volver a Proyectos</span>
      <span class="lang-en">Back to Projects</span>
    </a>
  </div>

  <div class="project-grid">
    <!-- Project info and description -->
    <div class="project-main-column">
      <article class="pixel-box project-detail-box">
        <header class="project-header">
          <div class="project-meta">
            <span class="badge warning">
              <span class="lang-es">Desde: {formatDate(project.data.startDate)}</span>
              <span class="lang-en">Since: {formatDate(project.data.startDate)}</span>
            </span>
            <span class="badge success">
              <span class="lang-es">{project.data.status}</span>
              <span class="lang-en">{project.data.status === 'Planificación' ? 'Planning' : project.data.status === 'En Desarrollo' ? 'In Development' : project.data.status === 'Pausado' ? 'Paused' : project.data.status === 'Completado' ? 'Completed' : project.data.status}</span>
            </span>
          </div>
          <h1 class="project-title">
            <span class="lang-es">{project.data.title}</span>
            <span class="lang-en">{project.data.title_en || project.data.title}</span>
          </h1>
        </header>

        {project.data.coverImage && (
          <div class="project-cover-wrapper">
            <img src={project.data.coverImage} alt={project.data.title} class="project-cover" />
          </div>
        )}

        <div class="project-content content-multilang">
          <Content />
        </div>
      </article>
    </div>

    <!-- Timeline column -->
    <div class="project-timeline-column">
      <h2 class="section-title">
        <span class="lang-es">Línea de Tiempo (Devlog)</span>
        <span class="lang-en">Milestone Timeline (Devlog)</span>
      </h2>
      <DevlogTimeline devlogs={projectDevlogs} />
    </div>
  </div>
</Layout>

<style>
  .project-navigation {
    margin-bottom: 2rem;
  }

  .back-link {
    font-family: var(--font-pixel);
    font-size: 0.85rem;
    color: var(--color-accent-green);
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .back-link:hover {
    color: var(--color-accent-yellow);
  }

  .project-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 3rem;
    align-items: start;
  }

  @media (max-width: 990px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }

  .project-detail-box {
    padding: 2rem;
    background-color: var(--color-panel);
  }

  .project-header {
    margin-bottom: 1.5rem;
    border-bottom: 2px dashed var(--color-border);
    padding-bottom: 1.5rem;
  }

  .project-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .project-title {
    font-size: 1.6rem;
    color: var(--color-accent-yellow);
    line-height: 1.3;
  }

  .project-cover-wrapper {
    width: 100%;
    max-height: 350px;
    overflow: hidden;
    border: var(--border-width) solid var(--color-border);
    margin-bottom: 2rem;
    background-color: var(--color-bg);
  }

  .project-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    image-rendering: pixelated;
  }

  .project-content {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text);
  }

  .project-content :global(p) {
    margin-bottom: 1.25rem;
  }

  .project-content :global(h3) {
    color: var(--color-accent-yellow);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.1rem;
  }

  .project-content :global(ul) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .project-content :global(li) {
    margin-bottom: 0.5rem;
    color: var(--color-text-muted);
  }
</style>
