---
import { formatDate } from '../utils/date';

interface Devlog {
  id: string;
  data: {
    project: string;
    title: string;
    title_en?: string;
    date: Date;
    summary: string;
    summary_en?: string;
    image?: string;
  };
}

interface Props {
  devlogs: Devlog[];
}

const { devlogs } = Astro.props;

// Sort devlogs by date descending
const sortedDevlogs = [...devlogs].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<div class="timeline-container">
  {sortedDevlogs.length === 0 ? (
    <div class="pixel-box empty-timeline">
      <p class="lang-es">Aún no se han registrado hitos o avances para este proyecto.</p>
      <p class="lang-en">No milestones or updates have been logged for this project yet.</p>
    </div>
  ) : (
    <div class="timeline-line">
      {sortedDevlogs.map((devlog) => (
        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content-wrapper">
            <div class="timeline-date">
              <span class="badge warning">{formatDate(devlog.data.date)}</span>
            </div>
            <div class="pixel-box timeline-card">
              <h3 class="timeline-title">
                <span class="lang-es">{devlog.data.title}</span>
                <span class="lang-en">{devlog.data.title_en || devlog.data.title}</span>
              </h3>
              <p class="timeline-summary">
                <span class="lang-es">{devlog.data.summary}</span>
                <span class="lang-en">{devlog.data.summary_en || devlog.data.summary}</span>
              </p>
              
              {devlog.data.image && (
                <div class="timeline-image-wrapper">
                  <img src={devlog.data.image} alt={devlog.data.title} class="timeline-image" />
                </div>
              )}
              
              <div class="timeline-details-link">
                <a href={`/proyectos/devlogs/${devlog.id}`} class="btn btn-secondary btn-xs">
                  <span class="lang-es">Leer bitácora completa</span>
                  <span class="lang-en">Read full devlog entry</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  )}
</div>

<style>
  .timeline-container {
    position: relative;
    padding: 1rem 0;
  }

  .empty-timeline {
    text-align: center;
    color: var(--color-text-muted);
  }

  .timeline-line {
    position: relative;
    padding-left: 2.5rem;
  }

  .timeline-line::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 10px;
    width: 4px;
    background-color: var(--color-border);
    border-left: 2px dashed rgba(140, 168, 141, 0.4);
  }

  .timeline-item {
    position: relative;
    margin-bottom: 3rem;
  }

  .timeline-item:last-child {
    margin-bottom: 1rem;
  }

  .timeline-marker {
    position: absolute;
    left: -2.5rem;
    top: 6px;
    width: 24px;
    height: 24px;
    background-color: var(--color-bg);
    border: var(--border-width) solid var(--color-accent-green);
    box-shadow: 2px 2px 0px rgba(0,0,0,0.3);
    z-index: 10;
    transform: rotate(45deg);
  }

  .timeline-item:hover .timeline-marker {
    background-color: var(--color-accent-yellow);
    border-color: var(--color-accent-yellow);
  }

  .timeline-content-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .timeline-date {
    display: flex;
  }

  .timeline-card {
    background-color: var(--color-panel);
    padding: 1.5rem;
  }

  .timeline-title {
    font-size: 0.95rem;
    color: var(--color-accent-yellow);
    margin-bottom: 0.75rem;
    line-height: 1.4;
  }

  .timeline-summary {
    font-size: 0.9rem;
    color: var(--color-text);
    margin-bottom: 1.25rem;
  }

  .timeline-image-wrapper {
    width: 100%;
    max-height: 300px;
    overflow: hidden;
    border: var(--border-width) solid var(--color-border);
    margin-bottom: 1.25rem;
    background-color: var(--color-bg);
  }

  .timeline-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    image-rendering: pixelated;
  }

  .timeline-details-link {
    display: flex;
    justify-content: flex-end;
  }

  .btn-xs {
    padding: 0.4rem 0.75rem;
    font-size: 0.7rem;
  }
</style>
